# ── Core ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GITHUB_TOKEN=your-github-personal-access-token   # Optional: raises API rate limits

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → New OAuth App
# Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# ── GitHub Webhook ────────────────────────────────────────────────────────────
# Set this to a random string and configure the same value in GitHub repo settings
# Webhook URL: https://your-domain.com/webhook/github
# Content type: application/json
WEBHOOK_SECRET=your-random-webhook-secret-string

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-to-a-random-32-char-string

# ── Database ──────────────────────────────────────────────────────────────────
# Docker Compose sets this automatically. Override for external Postgres.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pr_reviews

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for: Celery task queue, SSE pub/sub, GitHub API response cache
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
